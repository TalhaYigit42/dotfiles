// Lain glitch: windows open/close with a quick RGB split + sliced scanline jitter.
// Toggle with Mod+Shift+G (scripts/glitch-toggle.sh).
animations {
    window-open {
        duration-ms 320
        curve "linear"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float g = 1.0 - p;
                float band = floor(coords_geo.y * 26.0);
                float r = fract(sin(band * 91.7 + niri_random_seed * 13.1) * 43758.5453);
                float shift = (r - 0.5) * 0.14 * g * step(0.6, r);
                float x = clamp(coords_geo.x + shift, 0.0, 1.0);
                float ca = 0.012 * g;
                vec3 cr = niri_geo_to_tex * vec3(clamp(x + ca, 0.0, 1.0), coords_geo.y, 1.0);
                vec3 cg = niri_geo_to_tex * vec3(x, coords_geo.y, 1.0);
                vec3 cb = niri_geo_to_tex * vec3(clamp(x - ca, 0.0, 1.0), coords_geo.y, 1.0);
                vec4 mid = texture2D(niri_tex, cg.st);
                vec4 col = vec4(texture2D(niri_tex, cr.st).r, mid.g, texture2D(niri_tex, cb.st).b, mid.a);
                float scan = 1.0 - g * 0.25 * (0.5 + 0.5 * sin(coords_geo.y * size_geo.y * 1.4));
                return col * scan * smoothstep(0.0, 0.45, p);
            }
        "
    }
    window-close {
        duration-ms 220
        curve "linear"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float band = floor(coords_geo.y * 20.0);
                float r = fract(sin(band * 57.3 + niri_random_seed * 7.7) * 43758.5453);
                float shift = (r - 0.5) * 0.2 * p * step(0.5, r);
                float x = clamp(coords_geo.x + shift, 0.0, 1.0);
                float ca = 0.015 * p;
                vec3 cr = niri_geo_to_tex * vec3(clamp(x + ca, 0.0, 1.0), coords_geo.y, 1.0);
                vec3 cg = niri_geo_to_tex * vec3(x, coords_geo.y, 1.0);
                vec3 cb = niri_geo_to_tex * vec3(clamp(x - ca, 0.0, 1.0), coords_geo.y, 1.0);
                vec4 mid = texture2D(niri_tex, cg.st);
                vec4 col = vec4(texture2D(niri_tex, cr.st).r, mid.g, texture2D(niri_tex, cb.st).b, mid.a);
                return col * (1.0 - smoothstep(0.55, 1.0, p));
            }
        "
    }
}
